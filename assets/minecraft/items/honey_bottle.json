{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "select",
      "property": "component",
      "component": "custom_name",
      "fallback": {
        "type": "model",
        "model": "item/honey_bottle"
      },
      "cases": [
        {
          "when": "\u041F\u0438\u0432\u043E",
          "model": {
            "type": "model",
            "model": "item/beer"
          }
        }
      ]
    },
    "cases": [
      {
        "when": "7",
        "model": {
          "type": "model",
          "model": "item/purple_potion"
        }
      },
      {
        "when": "8",
        "model": {
          "type": "model",
          "model": "item/sculk_potion"
        }
      }
    ]
  }
}